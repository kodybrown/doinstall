description: Format, lint, compile and inspect daily tools; use --profile release for full optimization.
options:
  - {name: profile, choices: [dev, release], default: dev}
requires: [{kind: tool, value: cargo}]
steps:
  - exec:
      executable: cargo
      arguments: [run, --quiet, --locked, --profile, bootstrap, --package, doinstall-dev, --, build, --profile, {parameter: profile}]
