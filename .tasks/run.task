description: Build and run an inspected tool without installing it; daily profile by default.
options:
  - {name: profile, choices: [dev, release], default: dev}
  - {name: bin, choices: [doinstall, doinstall-builder, doinstall-launcher, doinstall-server], default: doinstall}
  - {name: args, default: '[]', description: JSON array of literal application arguments.}
requires: [{kind: tool, value: cargo}]
steps:
  - exec:
      executable: cargo
      arguments: [run, --quiet, --locked, --profile, bootstrap, --package, doinstall-dev, --, run, --profile, {parameter: profile}, --bin, {parameter: bin}, --args, {parameter: args}]
