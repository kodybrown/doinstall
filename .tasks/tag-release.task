description: Create a verified main release tag; --push starts GitHub publication.
options:
  - {name: create, type: bool, default: true}
  - {name: push, type: bool, default: false}
requires: [{kind: task, value: _/rust/tag-release.rs}]
steps:
  - run: _/rust/tag-release.rs
    with:
      create: {parameter: create}
      push: {parameter: push}
      repo: kodybrown/doinstall
      branch: main
      workflow: release.yml
