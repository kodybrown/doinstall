description: Build and inspect tools, run all tests, lint and verify shims; daily profile by default.
options:
  - {name: profile, choices: [dev, release], default: dev}
requires: [{kind: tool, value: cargo}, {kind: tool, value: git}]
steps:
  - exec:
      executable: cargo
      arguments: [run, --quiet, --locked, --profile, bootstrap, --package, doinstall-dev, --, verify, --profile, {parameter: profile}]
