[Unit]
Description={{id}} private Redis
After=network.target

[Service]
Type=simple
User={{id}}
Group={{id}}
ExecStart=/usr/bin/redis-server {{redis_path}}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{state_dir}}
UMask=0077

[Install]
WantedBy=multi-user.target
